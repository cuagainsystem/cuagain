# Copy this file to .env.local when Supabase is connected (Phase 3).
# Only the public (publishable) key belongs here. It is visible in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Never put these in a VITE_ variable or commit them:
#   Supabase service-role key, Brevo API key, database password.
# Keep them as server-side secrets in Supabase Edge Functions or Cloudflare Workers.
