# Copy this file to .env.local and fill in the values. .env.local is never committed.

# Supabase project settings: Project Settings, API.
# Only the public (publishable / anon) key belongs here. It is visible in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# The approved school email domain, for example g.cu.edu.ph (no @).
# Leave it empty until the university confirms the exact domain. While empty, registration
# still requires the email prefix to match the student ID, but does not check the domain.
VITE_SCHOOL_EMAIL_DOMAIN=

# Never put these in a VITE_ variable or commit them:
#   Supabase service-role key, Brevo API key, database password.
# Keep them as server-side secrets in Supabase Edge Functions or Cloudflare Workers.
